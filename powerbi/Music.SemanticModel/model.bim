      {
        "name": "fact_grammy_record",
        "columns": [
          {
            "name": "source_row_id",
            "dataType": "int64",
            "sourceColumn": "source_row_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "year_key",
            "dataType": "int64",
            "sourceColumn": "year_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "category_key",
            "dataType": "int64",
            "sourceColumn": "category_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "artist_key",
            "dataType": "int64",
            "sourceColumn": "artist_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "track_key",
            "dataType": "int64",
            "sourceColumn": "track_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "nominee",
            "dataType": "string",
            "sourceColumn": "nominee",
            "summarizeBy": "none"
          },
          {
            "name": "eligible",
            "dataType": "boolean",
            "sourceColumn": "eligible",
            "summarizeBy": "none"
          },
          {
            "name": "match_status",
            "dataType": "string",
            "sourceColumn": "match_status",
            "summarizeBy": "none"
          },
          {
            "name": "candidate_count",
            "dataType": "int64",
            "sourceColumn": "candidate_count",
            "summarizeBy": "none"
          },
          {
            "name": "popularity",
            "dataType": "double",
            "sourceColumn": "popularity",
            "summarizeBy": "none"
          },
          {
            "name": "energy",
            "dataType": "double",
            "sourceColumn": "energy",
            "summarizeBy": "none"
          },
          {
            "name": "danceability",
            "dataType": "double",
            "sourceColumn": "danceability",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Elegibles",
            "expression": "CALCULATE(COUNTROWS('fact_grammy_record'), 'fact_grammy_record'[eligible] = TRUE())",
            "formatString": "#,0"
          },
          {
            "name": "Vinculados",
            "expression": "CALCULATE(COUNTROWS('fact_grammy_record'), 'fact_grammy_record'[eligible] = TRUE(), 'fact_grammy_record'[match_status] = \"matched\")",
            "formatString": "#,0"
          },
          {
            "name": "Cobertura",
            "expression": "DIVIDE([Vinculados], [Elegibles])",
            "formatString": "0.00%"
          },
          {
            "name": "Popularidad media",
            "expression": "AVERAGEX(CALCULATETABLE(VALUES('fact_grammy_record'[track_key]), 'fact_grammy_record'[match_status] = \"matched\"), CALCULATE(MAX('fact_grammy_record'[popularity])))",
            "formatString": "0.00"
          },
          {
            "name": "Canciones por categoria",
            "expression": "CALCULATE(DISTINCTCOUNT('fact_grammy_record'[track_key]), 'fact_grammy_record'[match_status] = \"matched\")",
            "formatString": "#,0"
          },
          {
            "name": "Energia media",
            "expression": "AVERAGEX(CALCULATETABLE(VALUES('fact_grammy_record'[track_key]), 'fact_grammy_record'[match_status] = \"matched\"), CALCULATE(MAX('fact_grammy_record'[energy])))",
            "formatString": "0.0000"
          },
          {
            "name": "Bailabilidad media",
            "expression": "AVERAGEX(CALCULATETABLE(VALUES('fact_grammy_record'[track_key]), 'fact_grammy_record'[match_status] = \"matched\"), CALCULATE(MAX('fact_grammy_record'[danceability])))",
            "formatString": "0.0000"
          },
          {
            "name": "Canciones por decada",
            "expression": "CALCULATE(DISTINCTCOUNT('fact_grammy_record'[track_key]), 'fact_grammy_record'[match_status] = \"matched\")",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "fact_grammy_record",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"localhost:5433\", \"music_dw\", [CreateNavigationProperties=false]),",
                "    Table = Source{[Schema=\"dw\", Item=\"fact_grammy_record\"]}[Data]",
                "in",
                "    Table"
              ]
            }
          }
        ]
      }
